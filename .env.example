# Aplicacao
APP_ENV=
PORT=
SITE_URL=

# Banco de dados
# Placeholder local ou secret de hosting. Nunca versionar valor real.
DATABASE_URL=
DB_MAX_CONNS=4

# Supabase
# URL publica do projeto Supabase para imagens publicas do Storage.
# Tambem usada pelo login administrativo quando a Fase 13.1 estiver configurada.
SUPABASE_URL=

# Admin
# Opcional. Sem estes valores, a loja publica inicia normalmente e /admin/login fica indisponivel.
SUPABASE_PUBLISHABLE_KEY=
ADMIN_SUPABASE_USER_ID=

# SuperFrete
# Opcional enquanto a cotacao de frete real nao estiver habilitada.
# Valores permitidos para SUPERFRETE_ENV: sandbox, production.
SUPERFRETE_ENV=
SUPERFRETE_API_TOKEN=
SUPERFRETE_ORIGIN_POSTAL_CODE=
SUPERFRETE_CONTACT_EMAIL=
SUPERFRETE_SERVICES=

# InfinitePay
# InfiniteTag/handle sem "$". Opcional; sem valor, o botao de pagamento fica indisponivel.
INFINITEPAY_HANDLE=
