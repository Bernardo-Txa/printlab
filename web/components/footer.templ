package components

templ Footer() {
	<footer class="border-t border-border bg-surface">
		@Container() {
			<div class="flex flex-col gap-5 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
				<div>
					<p class="text-base font-semibold text-foreground">PrintLab</p>
					<p class="mt-1">Impressao 3D com base digital em desenvolvimento.</p>
				</div>
				<nav aria-label="Navegacao do rodape">
					<ul class="flex flex-wrap gap-x-4 gap-y-2">
						<li><a class="nav-link" href="#inicio">Inicio</a></li>
						<li><a class="nav-link" href="#sobre">Sobre</a></li>
						<li><a class="nav-link" href="#contato">Contato</a></li>
					</ul>
				</nav>
			</div>
		}
	</footer>
}
