package components

templ MoleculeGraphic(className string) {
	<svg class={ className } viewBox="0 0 220 160" aria-hidden="true" focusable="false">
		<path d="M48 96 92 54 138 88 178 42" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path>
		<circle cx="48" cy="96" r="13" fill="currentColor"></circle>
		<circle cx="92" cy="54" r="10" fill="currentColor"></circle>
		<circle cx="138" cy="88" r="15" fill="currentColor"></circle>
		<circle cx="178" cy="42" r="11" fill="currentColor"></circle>
		<path d="M72 124c28 18 62 20 102 6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.45"></path>
	</svg>
}

templ LayerStackGraphic() {
	<div class="brand-layer-stack" aria-hidden="true">
		<span class="brand-layer brand-layer-blue"></span>
		<span class="brand-layer brand-layer-teal"></span>
		<span class="brand-layer brand-layer-pink"></span>
		<span class="brand-layer brand-layer-yellow"></span>
	</div>
}
