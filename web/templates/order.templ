package templates

import (
	"strconv"

	ordersdomain "github.com/Bernardo-Txa/printlab/internal/orders"
	paymentsdomain "github.com/Bernardo-Txa/printlab/internal/payments"
	"github.com/Bernardo-Txa/printlab/web/components"
)

templ CheckoutReview(page ordersdomain.ReviewPage) {
	@components.Layout("Revisão | PrintLab", "Revise produtos, dados, entrega e frete antes de criar o pedido.", "") {
		<section class="checkout-section">
			@components.Container() {
				<div class="checkout-heading">
					<p class="brand-kicker">Checkout seguro</p>
					<p class="checkout-step-eyebrow">Etapa 3 de 4</p>
					<h1>Revise seu pedido</h1>
					<p>Confira produtos, dados e entrega antes de criar o pedido. O pagamento será feito na próxima etapa.</p>
				</div>
				@CheckoutStepper(3, false)
				if page.Message != "" {
					<p class="checkout-alert checkout-alert-error">{ page.Message }</p>
				}
				<div class="checkout-layout">
					<form class="checkout-form" method="post" action="/checkout/revisao">
						<input type="hidden" name="review_fingerprint" value={ page.Fingerprint }/>
						<section class="checkout-form-section" aria-labelledby="review-products">
							<div class="review-section-header">
								<span class="checkout-section-icon" aria-hidden="true">@checkoutReviewIcon()</span>
								<div>
									<h2 id="review-products">Produtos</h2>
									<p>Itens que serão congelados no pedido.</p>
								</div>
							</div>
							<div class="review-items">
								for _, item := range page.Items {
									<article class="review-item">
										<div class="review-item-main">
											<h3>{ item.ProductName }</h3>
											if item.ColorName != "" {
												<p>Cor: { item.ColorName }</p>
											}
											if item.HasVariant {
												<p>{ item.VariantName }</p>
											}
										</div>
										<div class="review-item-values">
											<p><span>Quantidade</span><strong>{ strconv.Itoa(item.Quantity) }</strong></p>
											<p><span>Unitário</span><strong>{ item.UnitPriceBRL }</strong></p>
											<p><span>Subtotal</span><strong>{ item.LineTotalBRL }</strong></p>
										</div>
									</article>
								}
							</div>
						</section>
						<section class="checkout-form-section" aria-labelledby="review-customer">
							<div class="review-section-header">
								<span class="checkout-section-icon" aria-hidden="true">@checkoutProfileIcon()</span>
								<div>
									<h2 id="review-customer">Dados pessoais</h2>
									<p>Informações de contato do pedido.</p>
								</div>
								<a href="/checkout/dados">Editar dados</a>
							</div>
							<div class="review-detail-grid">
								<p><span>Nome</span><strong>{ page.Customer.FullName }</strong></p>
								<p><span>E-mail</span><strong>{ page.Customer.Email }</strong></p>
								<p><span>Telefone</span><strong>{ page.Customer.Phone }</strong></p>
								<p><span>CPF</span><strong>{ page.Customer.MaskedCPF }</strong></p>
							</div>
						</section>
						if page.HasAddress && page.Shipping.DeliveryMethod != "pickup" {
							<section class="checkout-form-section" aria-labelledby="review-address">
								<div class="review-section-header">
									<span class="checkout-section-icon" aria-hidden="true">@checkoutAddressIcon()</span>
									<div>
										<h2 id="review-address">Endereço de entrega</h2>
										<p>Destino usado para a cotação selecionada.</p>
									</div>
									<a href="/checkout/frete?delivery_method=shipping#shipping-address">Editar endereço</a>
								</div>
								<div class="review-address">
									<p>{ page.Address.LineOne }</p>
									<p>{ page.Address.LineTwo }</p>
									<p>{ page.Address.CountryCode }</p>
								</div>
							</section>
						}
						<section class="checkout-form-section" aria-labelledby="review-shipping">
							<div class="review-section-header">
								<span class="checkout-section-icon" aria-hidden="true">@checkoutDeliveryIcon()</span>
								<div>
									<h2 id="review-shipping">Entrega</h2>
									<p>Modalidade escolhida para este pedido.</p>
								</div>
								<a href="/checkout/frete">Alterar entrega</a>
							</div>
							<div class="review-detail-grid">
								if page.Shipping.DeliveryMethod == "pickup" {
									<p><span>Entrega</span><strong>Retirada no local</strong></p>
									<p><span>Frete</span><strong>Grátis</strong></p>
									<p class="review-detail-note">Após a confirmação do pedido, entraremos em contato para combinar o horário da retirada.</p>
								} else {
									<p><span>Serviço</span><strong>{ page.Shipping.ServiceName }</strong></p>
									if page.Shipping.CarrierName != "" {
										<p><span>Transportadora</span><strong>{ page.Shipping.CarrierName }</strong></p>
									}
									<p><span>Prazo</span><strong>{ page.Shipping.DeliveryTime }</strong></p>
									<p><span>Frete</span><strong>{ page.Shipping.PriceBRL }</strong></p>
								}
							</div>
						</section>
						<div class="checkout-form-actions checkout-review-actions">
							<div class="checkout-action-copy">O pagamento será feito na próxima etapa.</div>
							<button class="btn-base btn-primary" type="submit">Confirmar pedido</button>
							<a class="btn-base btn-secondary" href="/checkout/frete">Voltar à entrega</a>
						</div>
					</form>
					<aside class="checkout-summary" aria-label="Resumo do pedido">
						<h2>Resumo</h2>
						<div class="checkout-summary-lines">
							for _, item := range page.Items {
								<div class="checkout-summary-line">
									<div>
										<strong>{ item.ProductName }</strong>
										if item.ColorName != "" {
											<span>Cor: { item.ColorName }</span>
										}
										if item.HasVariant {
											<span>{ item.VariantName }</span>
										}
										<span>Quantidade: { strconv.Itoa(item.Quantity) }</span>
									</div>
									<p>{ item.LineTotalBRL }</p>
								</div>
							}
						</div>
						<div class="checkout-summary-total"><span>Produtos</span><strong>{ page.ProductsSubtotalBRL }</strong></div>
						<div class="checkout-summary-total">
							<span>Entrega</span>
							if page.Shipping.DeliveryMethod == "pickup" {
								<strong>Grátis</strong>
							} else {
								<strong>{ page.ShippingPriceBRL }</strong>
							}
						</div>
						<div class="checkout-summary-total checkout-summary-grand-total"><span>Total</span><strong>{ page.TotalBRL }</strong></div>
						<p>Após confirmar, você seguirá para o pagamento.</p>
					</aside>
				</div>
			}
		</section>
	}
}

templ OrderConfirmation(page ordersdomain.OrderPage, payment paymentsdomain.OrderPaymentView) {
	@components.Layout("Pedido criado | PrintLab", "Pedido criado na PrintLab.", "") {
		<section class="checkout-section">
			@components.Container() {
				<div class="checkout-heading checkout-payment-heading">
					<p class="brand-kicker">Checkout seguro</p>
					<p class="checkout-step-eyebrow">Etapa 4 de 4</p>
					if payment.ShowConfirmed {
						<h1>Pagamento confirmado.</h1>
						<p>Seu pedido { page.OrderNumberLabel } está pago e pronto para seguir o fluxo da PrintLab.</p>
					} else {
						<h1>Pedido criado. Falta só o pagamento.</h1>
						<p>Finalize no ambiente seguro da InfinitePay para confirmar o pedido { page.OrderNumberLabel }.</p>
					}
				</div>
				@CheckoutStepper(4, false)
				<div class="order-status-panel">
					<div><span>Pedido</span><strong>Pedido { page.OrderNumberLabel }</strong></div>
					<div><span>Status</span><strong class="order-status-badge">{ page.StatusLabel }</strong></div>
				</div>
				<div class="checkout-layout">
					<div class="checkout-form">
						<section class="checkout-form-section" aria-labelledby="order-items">
							<div class="review-section-header">
								<span class="checkout-section-icon" aria-hidden="true">@checkoutReviewIcon()</span>
								<div>
									<h2 id="order-items">Itens do pedido</h2>
									<p>Resumo congelado no momento da criação.</p>
								</div>
							</div>
							<div class="review-items">
								for _, item := range page.Items {
									<article class="review-item">
										<div class="review-item-main">
											<h3>{ item.ProductName }</h3>
											if item.ColorName != "" {
												<p>Cor: { item.ColorName }</p>
											}
											if item.HasVariant {
												<p>{ item.VariantName }</p>
											}
										</div>
										<div class="review-item-values">
											<p><span>Quantidade</span><strong>{ strconv.Itoa(item.Quantity) }</strong></p>
											<p><span>Unitário</span><strong>{ item.UnitPriceBRL }</strong></p>
											<p><span>Subtotal</span><strong>{ item.LineTotalBRL }</strong></p>
										</div>
									</article>
								}
							</div>
						</section>
						<section class="checkout-form-section" aria-labelledby="order-shipping">
							<div class="review-section-header">
								<span class="checkout-section-icon" aria-hidden="true">@checkoutDeliveryIcon()</span>
								<div>
									<h2 id="order-shipping">Entrega</h2>
									<p>Modalidade registrada no pedido.</p>
								</div>
							</div>
							<div class="review-detail-grid">
								if page.Shipping.DeliveryMethod == "pickup" {
									<p><span>Entrega</span><strong>Retirada no local</strong></p>
									<p><span>Frete</span><strong>Grátis</strong></p>
									<p class="review-detail-note">Após a confirmação do pedido, entraremos em contato para combinar o horário da retirada.</p>
								} else {
									<p><span>Serviço</span><strong>{ page.Shipping.ServiceName }</strong></p>
									if page.Shipping.CarrierName != "" {
										<p><span>Transportadora</span><strong>{ page.Shipping.CarrierName }</strong></p>
									}
									<p><span>Prazo</span><strong>{ page.Shipping.DeliveryTime }</strong></p>
								}
							</div>
						</section>
					</div>
					<aside class="checkout-summary" aria-label="Resumo do pedido">
						<h2>Resumo</h2>
						<div class="checkout-summary-total"><span>Produtos</span><strong>{ page.ProductsSubtotalBRL }</strong></div>
						<div class="checkout-summary-total">
							<span>Entrega</span>
							if page.Shipping.DeliveryMethod == "pickup" {
								<strong>Grátis</strong>
							} else {
								<strong>{ page.ShippingPriceBRL }</strong>
							}
						</div>
						<div class="checkout-summary-total checkout-summary-grand-total"><span>Total</span><strong>{ page.TotalBRL }</strong></div>
						if payment.ShowConfirmed {
							<p class="checkout-alert checkout-alert-success">{ payment.Message }</p>
						} else {
							if payment.Message != "" {
								<p>{ payment.Message }</p>
							}
							if payment.ShowUnavailable {
								<p class="checkout-alert checkout-alert-error">{ payment.UnavailableMessage }</p>
							}
							if payment.CanPay {
								<div class="payment-card">
									<span class="payment-card-icon" aria-hidden="true">@checkoutLockIcon()</span>
									<div>
										<strong>Pagamento seguro InfinitePay</strong>
										<p>Você será direcionado para finalizar o pagamento. A PrintLab não armazena dados do cartão.</p>
									</div>
								</div>
								<form method="post" action={ "/pedido/" + page.ID + "/pagar" }><button class="btn-base btn-primary" type="submit">Pagar agora</button></form>
							}
						}
						if page.TrackingURL != "" {
							<a class="btn-base btn-secondary" href={ page.TrackingURL }>Acompanhar pedido</a>
						}
						<p>Use o número do pedido como referência humana.</p>
					</aside>
				</div>
			}
		</section>
	}
}

templ OrderTracking(page ordersdomain.TrackingPage) {
	@components.PrivateNoIndexLayout("Acompanhar pedido "+page.OrderNumberLabel+" | PrintLab", "Acompanhamento seguro do pedido PrintLab.") {
		<section class="tracking-section">
			@components.Container() {
				<div class="tracking-heading">
					<p class="brand-kicker">Acompanhamento</p>
					<h1>Pedido { page.OrderNumberLabel }</h1>
					<p>Status básico do pedido, sem dados pessoais ou informações internas de pagamento.</p>
				</div>
				<div class="tracking-overview" aria-label="Resumo do pedido">
					<p>
						<span>Pedido</span>
						<strong>Pedido { page.OrderNumberLabel }</strong>
					</p>
					<p>
						<span>Data do pedido</span>
						<strong><time datetime={ page.CreatedAtISO }>{ page.CreatedAtLabel }</time></strong>
					</p>
					<p>
						<span>Pagamento</span>
						<strong>{ page.PaymentStatusLabel }</strong>
					</p>
					if page.ShippingServiceLabel != "" {
						<p>
							<span>Serviço de envio</span>
							<strong>{ page.ShippingServiceLabel }</strong>
						</p>
					}
				</div>
				<div class="tracking-steps" aria-label="Status do pedido">
					for _, step := range page.Steps {
						<article class="tracking-card">
							<span>{ step.Title }</span>
							<strong>{ step.StatusLabel }</strong>
							<p>{ step.Description }</p>
						</article>
					}
				</div>
			}
		</section>
	}
}

templ PaymentReturn(page paymentsdomain.ReturnPage) {
	@components.Layout(page.Title+" | PrintLab", page.Message, "") {
		<section class="section-block">
			@components.Container() {
				<div class="checkout-form-section">
					<h1>{ page.Title }</h1>
					<p>{ page.Message }</p>
					if page.CanReturnToOrder {
						<a class="btn-base btn-secondary" href={ "/pedido/" + page.OrderID }>Voltar ao pedido</a>
					}
				</div>
			}
		</section>
	}
}

templ OrderTrackingUnavailable() {
	@components.PrivateNoIndexLayout("Acompanhamento indisponível | PrintLab", "Acompanhamento temporariamente indisponível.") {
		<section class="section-block">
			@components.Container() {
				@components.EmptyState("Acompanhamento temporariamente indisponível.", "Não foi possível carregar este acompanhamento agora. Tente novamente em alguns instantes.")
			}
		</section>
	}
}

templ CheckoutReviewUnavailable() {
	@components.Layout("Revisão indisponível | PrintLab", "Revisão de checkout temporariamente indisponível.", "") {
		<section class="section-block">
			@components.Container() {
				@components.EmptyState("Revisão temporariamente indisponível.", "Não foi possível carregar esta etapa agora. Tente novamente em alguns instantes.")
			}
		</section>
	}
}

templ OrderUnavailable() {
	@components.Layout("Pedido indisponível | PrintLab", "Pedido temporariamente indisponível.", "") {
		<section class="section-block">
			@components.Container() {
				@components.EmptyState("Pedido temporariamente indisponível.", "Não foi possível carregar este pedido agora. Tente novamente em alguns instantes.")
			}
		</section>
	}
}
