package templates

import (
	"strconv"

	"github.com/Bernardo-Txa/printlab/internal/shipping"
	"github.com/Bernardo-Txa/printlab/web/components"
)

templ CheckoutShipping(page shipping.CheckoutShippingPage) {
	@components.Layout("Frete | PrintLab", "Escolha de frete para compra na PrintLab.", "") {
		<section class="checkout-section">
			@components.Container() {
				<div class="checkout-heading">
					<p class="brand-kicker">Checkout</p>
					<h1>Etapa 2 - Entrega</h1>
					<p>Escolha como deseja receber seu pedido.</p>
				</div>
				<div class="checkout-stepper" aria-label="Etapas do checkout">
					<a class="checkout-step checkout-step-done" href="/checkout/dados">1 Dados</a>
					<span class="checkout-step checkout-step-active">2 Entrega</span>
					<span class="checkout-step">3 Revisão</span>
					<span class="checkout-step">4 Pagamento</span>
				</div>
				if page.Message != "" {
					if page.Selected {
						<p class="checkout-alert checkout-alert-success">{ page.Message }</p>
					} else {
						<p class="checkout-alert checkout-alert-error">{ page.Message }</p>
					}
				}
				<div class="checkout-layout">
					<div class="checkout-form">
						<section class="checkout-form-section" aria-labelledby="delivery-methods">
							<h2 id="delivery-methods">Como você deseja receber?</h2>
							<form method="get" action="/checkout/frete">
								<div class="shipping-options">
									<label class="shipping-option">
										<input type="radio" name="delivery_method" value="shipping" required checked?={ page.SelectedMethod == "shipping" }/>
										<span><strong>Receber em casa</strong><small>Calcular frete e prazo de entrega</small></span>
									</label>
									<label class="shipping-option">
										<input type="radio" name="delivery_method" value="pickup" required checked?={ page.SelectedMethod == "pickup" }/>
										<span><strong>Retirar no local</strong><small>Combinaremos o horário da retirada após a confirmação do pedido.</small></span>
										<span><strong>Grátis</strong></span>
									</label>
								</div>
								<div class="checkout-form-actions"><button class="btn-base btn-secondary" type="submit">Escolher modalidade</button></div>
							</form>
						</section>
						if page.SelectedMethod == "pickup" {
							<section class="checkout-form-section" aria-labelledby="pickup-details">
								<h2 id="pickup-details">Retirada no local</h2>
								<p>Após a confirmação do pedido, entraremos em contato para combinar o horário da retirada.</p>
								<form method="post" action="/checkout/frete">
									<input type="hidden" name="delivery_method" value="pickup"/>
									<div class="checkout-form-actions"><button class="btn-base btn-primary" type="submit">Continuar com retirada grátis</button></div>
								</form>
							</section>
						} else if page.SelectedMethod == "shipping" {
							if page.Unavailable || len(page.Quotes) == 0 {
								<section class="checkout-form-section" aria-labelledby="shipping-unavailable">
									<h2 id="shipping-unavailable">Frete indisponível</h2>
									<p class="checkout-field-help">Não conseguimos calcular automaticamente o frete para este carrinho.</p>
								</section>
							} else {
								<form method="post" action="/checkout/frete">
									<input type="hidden" name="delivery_method" value="shipping"/>
									<section class="checkout-form-section" aria-labelledby="shipping-options">
										<h2 id="shipping-options">Opções de frete</h2>
										<div class="shipping-options">
											for _, quote := range page.Quotes {
												<label class="shipping-option">
													<input type="radio" name="service_code" value={ quote.ServiceCode } checked?={ quote.Selected }/>
													<span>
														<strong>{ quote.ServiceName }</strong>
														if quote.CarrierName != "" {
															<small>{ quote.CarrierName }</small>
														}
													</span>
													<span>
														<strong>{ quote.PriceBRL }</strong>
														<small>{ quote.DeliveryTime }</small>
													</span>
												</label>
											}
										</div>
									</section>
									<div class="checkout-form-actions">
										<button class="btn-base btn-primary" type="submit">Selecionar frete</button>
										<a class="btn-base btn-secondary" href="/checkout/dados">Voltar aos dados</a>
									</div>
								</form>
							}
						}
					</div>
					<aside class="checkout-summary" aria-label="Resumo do checkout">
						<h2>Resumo</h2>
						<div class="checkout-summary-lines">
							for _, line := range page.Cart.Lines {
								if line.Available {
									<div class="checkout-summary-line">
										<div>
											<strong>{ line.ProductName }</strong>
											if line.ColorName != "" {
												<span>Cor: { line.ColorName }</span>
											}
											if line.HasVariant {
												<span>{ line.VariantName }</span>
											}
											<span>Quantidade: { strconv.Itoa(line.Quantity) }</span>
										</div>
										<p>{ line.SubtotalBRL }</p>
									</div>
								}
							}
						</div>
						<div class="checkout-summary-total">
							<span>Produtos</span>
							<strong>{ page.ProductsSubtotalBRL }</strong>
						</div>
						if page.ShippingPriceBRL != "" {
							<div class="checkout-summary-total">
								<span>Frete</span>
								if page.SelectedMethod == "pickup" {
									<strong>Grátis</strong>
								} else {
									<strong>{ page.ShippingPriceBRL }</strong>
								}
							</div>
							<div class="checkout-summary-total">
								<span>Total parcial</span>
								<strong>{ page.PartialTotalBRL }</strong>
							</div>
						} else {
							<p>Selecione uma opção para ver o total parcial.</p>
						}
						<p>Revisão do pedido será a próxima etapa.</p>
					</aside>
				</div>
			}
		</section>
	}
}

templ CheckoutShippingUnavailable() {
	@components.Layout("Frete indisponível | PrintLab", "Frete temporariamente indisponível.", "") {
		<section class="section-block">
			@components.Container() {
				@components.EmptyState("Frete temporariamente indisponível.", "Não foi possível carregar esta etapa agora. Tente novamente em alguns instantes.")
			}
		</section>
	}
}
