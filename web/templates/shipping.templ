package templates

import (
	"strconv"

	"github.com/Bernardo-Txa/printlab/internal/shipping"
	"github.com/Bernardo-Txa/printlab/web/components"
)

templ CheckoutShipping(page shipping.CheckoutShippingPage) {
	@components.Layout("Entrega | PrintLab", "Escolha de entrega para compra na PrintLab.", "") {
		<section class="checkout-section">
			@components.Container() {
				<div class="checkout-heading">
					<p class="brand-kicker">Checkout seguro</p>
					<p class="checkout-step-eyebrow">Etapa 2 de 4</p>
					<h1>Como você quer receber?</h1>
					<p>Escolha entre entrega em casa ou retirada no local. As regras e valores continuam calculados pelo servidor.</p>
				</div>
				@CheckoutStepper(2, false)
				if page.Message != "" {
					if page.Selected {
						<p class="checkout-alert checkout-alert-success">{ page.Message }</p>
					} else {
						<p class="checkout-alert checkout-alert-error">{ page.Message }</p>
					}
				}
				<div class="checkout-layout">
					<div class="checkout-form">
						<section class="checkout-form-section" aria-labelledby="delivery-methods">
							<div class="checkout-section-header">
								<span class="checkout-section-icon" aria-hidden="true">@checkoutDeliveryIcon()</span>
								<div>
									<h2 id="delivery-methods">Modalidade de entrega</h2>
									<p>Você pode receber em casa ou retirar no local após a confirmação do pedido.</p>
								</div>
							</div>
							<form method="get" action="/checkout/frete">
								<div class="shipping-options shipping-method-options">
									<label class="shipping-option shipping-method-card">
										<input type="radio" name="delivery_method" value="shipping" required checked?={ page.SelectedMethod == "shipping" }/>
										<span class="shipping-option-icon" aria-hidden="true">@checkoutDeliveryIcon()</span>
										<span class="shipping-option-copy"><strong>Receber em casa</strong><small>Calcular frete e prazo de entrega com as opções disponíveis.</small></span>
									</label>
									<label class="shipping-option shipping-method-card">
										<input type="radio" name="delivery_method" value="pickup" required checked?={ page.SelectedMethod == "pickup" }/>
										<span class="shipping-option-icon" aria-hidden="true">@checkoutPickupIcon()</span>
										<span class="shipping-option-copy"><strong>Retirar no local</strong><small>Combinaremos o horário da retirada após a confirmação do pedido.</small></span>
										<span class="shipping-option-price"><strong>Grátis</strong></span>
									</label>
								</div>
								<div class="checkout-form-actions"><button class="btn-base btn-secondary" type="submit">Ver opções de entrega</button></div>
							</form>
						</section>
						if page.SelectedMethod == "pickup" {
							<section class="checkout-form-section pickup-callout" aria-labelledby="pickup-details">
								<div class="checkout-section-header">
									<span class="checkout-section-icon" aria-hidden="true">@checkoutPickupIcon()</span>
									<div>
										<h2 id="pickup-details">Retirada no local</h2>
										<p>Após a confirmação do pedido, entraremos em contato para combinar o horário da retirada.</p>
									</div>
								</div>
								<div class="pickup-price"><span>Frete</span><strong>Grátis</strong></div>
								<form method="post" action="/checkout/frete">
									<input type="hidden" name="delivery_method" value="pickup"/>
									<div class="checkout-form-actions"><button class="btn-base btn-primary" type="submit">Continuar com retirada grátis</button></div>
								</form>
							</section>
						} else if page.SelectedMethod == "shipping" {
							if page.Unavailable || len(page.Quotes) == 0 {
								<section class="checkout-form-section shipping-unavailable-card" aria-labelledby="shipping-unavailable">
									<div class="checkout-section-header">
										<span class="checkout-section-icon" aria-hidden="true">@checkoutDeliveryIcon()</span>
										<div>
											<h2 id="shipping-unavailable">Frete indisponível</h2>
											<p>Não conseguimos calcular automaticamente o frete para este carrinho agora.</p>
										</div>
									</div>
									<a class="btn-base btn-secondary" href="/checkout/dados">Revisar dados de entrega</a>
								</section>
							} else {
								<form method="post" action="/checkout/frete">
									<input type="hidden" name="delivery_method" value="shipping"/>
									<section class="checkout-form-section" aria-labelledby="shipping-options">
										<div class="checkout-section-header">
											<span class="checkout-section-icon" aria-hidden="true">@checkoutDeliveryIcon()</span>
											<div>
												<h2 id="shipping-options">Opções de entrega</h2>
												<p>Compare serviço, prazo e valor antes de continuar.</p>
											</div>
										</div>
										<div class="shipping-options shipping-quote-options">
											for _, quote := range page.Quotes {
												<label class="shipping-option shipping-quote-card">
													<input type="radio" name="service_code" value={ quote.ServiceCode } checked?={ quote.Selected }/>
													<span class="shipping-option-copy">
														<strong>{ quote.ServiceName }</strong>
														if quote.CarrierName != "" {
															<small>{ quote.CarrierName }</small>
														}
													</span>
													<span class="shipping-option-deadline"><small>Prazo</small><strong>{ quote.DeliveryTime }</strong></span>
													<span class="shipping-option-price"><small>Preço</small><strong>{ quote.PriceBRL }</strong></span>
												</label>
											}
										</div>
									</section>
									<div class="checkout-form-actions">
										<button class="btn-base btn-primary" type="submit">Continuar para revisão</button>
										<a class="btn-base btn-secondary" href="/checkout/dados">Voltar aos dados</a>
									</div>
								</form>
							}
						}
					</div>
					<aside class="checkout-summary" aria-label="Resumo do checkout">
						<h2>Resumo</h2>
						<div class="checkout-summary-lines">
							for _, line := range page.Cart.Lines {
								if line.Available {
									<div class="checkout-summary-line">
										<div>
											<strong>{ line.ProductName }</strong>
											if line.ColorName != "" {
												<span>Cor: { line.ColorName }</span>
											}
											if line.HasVariant {
												<span>{ line.VariantName }</span>
											}
											<span>Quantidade: { strconv.Itoa(line.Quantity) }</span>
										</div>
										<p>{ line.SubtotalBRL }</p>
									</div>
								}
							}
						</div>
						<div class="checkout-summary-total">
							<span>Produtos</span>
							<strong>{ page.ProductsSubtotalBRL }</strong>
						</div>
						if page.ShippingPriceBRL != "" {
							<div class="checkout-summary-total">
								<span>Entrega</span>
								if page.SelectedMethod == "pickup" {
									<strong>Grátis</strong>
								} else {
									<strong>{ page.ShippingPriceBRL }</strong>
								}
							</div>
							<div class="checkout-summary-total checkout-summary-grand-total">
								<span>Total parcial</span>
								<strong>{ page.PartialTotalBRL }</strong>
							</div>
						} else {
							<p>Selecione uma opção para ver o total parcial.</p>
						}
						<p>Revisão do pedido será a próxima etapa.</p>
					</aside>
				</div>
			}
		</section>
	}
}

templ CheckoutShippingUnavailable() {
	@components.Layout("Frete indisponível | PrintLab", "Frete temporariamente indisponível.", "") {
		<section class="section-block">
			@components.Container() {
				@components.EmptyState("Frete temporariamente indisponível.", "Não foi possível carregar esta etapa agora. Tente novamente em alguns instantes.")
			}
		</section>
	}
}
