templ AdminBoxForm(page admindomain.AdminBoxFormPage) {
	@components.PrivateNoIndexLayout(page.Title + " | PrintLab", "Caixa administrativa da PrintLab.") {
		<section class="admin-section">
			@components.Container() {
				@adminShell("boxes") {
					<div class="admin-main">
						@adminFormHeader("Frete", page.Title, page.BackURL)
						if page.Message != "" {
							<p class="checkout-alert checkout-alert-success">{ page.Message }</p>
						}
						<form class="admin-form" method="post" action={ page.Action }>
							@adminTextField("name", "Nome", page.Form.Name, page.Errors.Get("name"), "text", true)
							@adminTextField("slug", "Slug", page.Form.Slug, page.Errors.Get("slug"), "text", false)
							<fieldset>
								<legend>Dimensoes internas</legend>
								<div class="admin-form-grid">
									@adminTextField("internal_height_mm", "Altura interna", page.Form.InternalHeightMM, page.Errors.Get("internal_height_mm"), "number", true)
									@adminTextField("internal_width_mm", "Largura interna", page.Form.InternalWidthMM, page.Errors.Get("internal_width_mm"), "number", true)
									@adminTextField("internal_length_mm", "Comprimento interno", page.Form.InternalLengthMM, page.Errors.Get("internal_length_mm"), "number", true)
								</div>
							</fieldset>
							<fieldset>
								<legend>Dimensoes externas</legend>
								<div class="admin-form-grid">
									@adminTextField("external_height_mm", "Altura externa", page.Form.ExternalHeightMM, page.Errors.Get("external_height_mm"), "number", true)
									@adminTextField("external_width_mm", "Largura externa", page.Form.ExternalWidthMM, page.Errors.Get("external_width_mm"), "number", true)
									@adminTextField("external_length_mm", "Comprimento externo", page.Form.ExternalLengthMM, page.Errors.Get("external_length_mm"), "number", true)
								</div>
							</fieldset>
							@adminTextField("packaging_weight_g", "Peso da embalagem", page.Form.PackagingWeightG, page.Errors.Get("packaging_weight_g"), "number", true)
							@adminTextField("sort_order", "Ordem", page.Form.SortOrder, page.Errors.Get("sort_order"), "number", true)
							@adminCheckboxField("is_active", "Caixa ativa", page.Form.IsActive)
							<div class="admin-form-actions">
								<button class="btn-base btn-primary" type="submit">{ page.SubmitLabel }</button>
								<a class="btn-base btn-secondary" href={ page.BackURL }>Cancelar</a>
							</div>
						</form>
					</div>
				}
			}
		</section>
	}
}

templ adminFormHeader(kicker string, title string, backURL string) {
	<div class="admin-heading admin-heading-row">
		<div>
			<p class="brand-kicker">{ kicker }</p>
			<h1>{ title }</h1>
		</div>
		<div class="admin-heading-actions">
			<a class="btn-base btn-secondary" href={ backURL }>Voltar</a>
		</div>
	</div>
}

templ adminListHeader(title string, newURL string) {
	<div class="admin-heading admin-heading-row">
		<div>
			<p class="brand-kicker">Catalogo</p>
			<h1>{ title }</h1>
		</div>
		<div class="admin-heading-actions">
			<a class="btn-base btn-primary" href={ newURL }>Novo</a>
		</div>
	</div>
}

templ adminTextField(name string, label string, value string, errorMessage string, inputType string, required bool) {
	<label class="admin-field" for={ "admin-" + name }>
		<span>{ label }</span>
		if required {
			<input id={ "admin-" + name } type={ inputType } name={ name } value={ value } required/>
		} else {
			<input id={ "admin-" + name } type={ inputType } name={ name } value={ value }/>
		}
		if errorMessage != "" {
			<small class="admin-error">{ errorMessage }</small>
		}
	</label>
}

templ adminTextareaField(name string, label string, value string, errorMessage string) {
	<label class="admin-field" for={ "admin-" + name }>
		<span>{ label }</span>
		<textarea id={ "admin-" + name } name={ name } rows="4">{ value }</textarea>
		if errorMessage != "" {
			<small class="admin-error">{ errorMessage }</small>
		}
	</label>
}

templ adminSelectField(name string, label string, selected string, options []admindomain.AdminSelectOption, errorMessage string, emptyLabel string) {
	<label class="admin-field" for={ "admin-" + name }>
		<span>{ label }</span>
		<select id={ "admin-" + name } name={ name }>
			if emptyLabel != "" {
				if selected == "" {
					<option value="" selected>{ emptyLabel }</option>
				} else {
					<option value="">{ emptyLabel }</option>
				}
			}
			for _, option := range options {
				if option.ID == selected {
					<option value={ option.ID } selected>{ option.Label }</option>
				} else {
					<option value={ option.ID }>{ option.Label }</option>
				}
			}
		</select>
		if errorMessage != "" {
			<small class="admin-error">{ errorMessage }</small>
		}
	</label>
}

templ adminCheckboxField(name string, label string, checked bool) {
	<label class="admin-checkbox">
		if checked {
			<input type="checkbox" name={ name } value="1" checked/>
		} else {
			<input type="checkbox" name={ name } value="1"/>
		}
		<span>{ label }</span>
	</label>
}

templ adminShippingProfileFields(useShipping bool, weight string, height string, width string, length string, errors admindomain.AdminFieldErrors) {
	<fieldset class="admin-fieldset">
		<legend>Perfil logistico</legend>
		@adminCheckboxField("use_shipping", "Usar perfil logistico neste registro", useShipping)
		if errors.Get("shipping_profile") != "" {
			<small class="admin-error">{ errors.Get("shipping_profile") }</small>
		}
		<div class="admin-form-grid">
			@adminTextField("shipping_weight_g", "Peso em gramas", weight, errors.Get("shipping_weight_g"), "number", false)
			@adminTextField("shipping_height_mm", "Altura em mm", height, errors.Get("shipping_height_mm"), "number", false)
			@adminTextField("shipping_width_mm", "Largura em mm", width, errors.Get("shipping_width_mm"), "number", false)
			@adminTextField("shipping_length_mm", "Comprimento em mm", length, errors.Get("shipping_length_mm"), "number", false)
		</div>
	</fieldset>
}

templ adminRecipeFields(materialID string, colorID string, weight string, label string, sortOrder string, materials []admindomain.AdminSelectOption, colors []admindomain.AdminSelectOption) {
	<div class="admin-form-grid">
		@adminSelectField("material_id", "Material", materialID, materials, "", "Selecione")
		@adminSelectField("color_id", "Cor", colorID, colors, "", "Selecione")
		@adminTextField("estimated_weight", "Peso em gramas", weight, "", "text", true)
		@adminTextField("label", "Label", label, "", "text", false)
		@adminTextField("sort_order", "Ordem", sortOrder, "", "number", true)
	</div>
}

templ adminSimpleEntityList(active string, title string, newURL string) {
	@components.PrivateNoIndexLayout(title + " administrativos | PrintLab", title + " administrativos da PrintLab.") {
		<section class="admin-section">
			@components.Container() {
				@adminShell(active) {
					<div class="admin-main">
						@adminListHeader(title, newURL)
						<div class="admin-order-list">
							{ children... }
						</div>
					</div>
				}
			}
		</section>
	}
}

templ adminEntityCard(name string, slug string, status string, detailURL string, description string) {
	<article class="admin-order-row">
		<div class="admin-order-row-header">
			<div>
				<a href={ detailURL }>{ name }</a>
				<span>{ slug }</span>
			</div>
			<strong>{ status }</strong>
		</div>
		if description != "" {
			<p class="admin-muted">{ description }</p>
		}
	</article>
}

templ adminBasicTextForm(active string, title string, action string, backURL string, submitLabel string, message string, name string, slug string, description string, isActive bool, errors admindomain.AdminFieldErrors) {
	@components.PrivateNoIndexLayout(title + " | PrintLab", title + " administrativo da PrintLab.") {
		<section class="admin-section">
			@components.Container() {
				@adminShell(active) {
					<div class="admin-main">
						@adminFormHeader("Catalogo", title, backURL)
						if message != "" {
							<p class="checkout-alert checkout-alert-success">{ message }</p>
						}
						<form class="admin-form" method="post" action={ action }>
							@adminTextField("name", "Nome", name, errors.Get("name"), "text", true)
							@adminTextField("slug", "Slug", slug, errors.Get("slug"), "text", false)
							@adminTextareaField("description", "Descricao", description, errors.Get("description"))
							@adminCheckboxField("is_active", "Ativo", isActive)
							<div class="admin-form-actions">
								<button class="btn-base btn-primary" type="submit">{ submitLabel }</button>
								<a class="btn-base btn-secondary" href={ backURL }>Cancelar</a>
							</div>
						</form>
					</div>
				}
			}
		</section>
	}
}

templ adminMetric(label string, value int, url string) {
	<a class="admin-metric" href={ url }>
		<span>{ label }</span>
		<strong>{ strconv.Itoa(value) }</strong>
	</a>
}

templ adminShell(active string) {
	<div class="admin-shell">
		<aside class="admin-sidebar" aria-label="Navegacao administrativa">
			<strong>PrintLab Admin</strong>
			<nav aria-label="Secoes administrativas">
				if active == "dashboard" {
					<span class="admin-nav-active">Visão geral</span>
				} else {
					<a class="admin-nav-link" href="/admin">Visão geral</a>
				}
				if active == "orders" {
					<span class="admin-nav-active">Pedidos</span>
				} else {
					<a class="admin-nav-link" href="/admin/pedidos">Pedidos</a>
				}
				if active == "products" {
					<span class="admin-nav-active">Produtos</span>
				} else {
					<a class="admin-nav-link" href="/admin/produtos">Produtos</a>
				}
				if active == "categories" {
					<span class="admin-nav-active">Categorias</span>
				} else {
					<a class="admin-nav-link" href="/admin/categorias">Categorias</a>
				}
				if active == "materials" {
					<span class="admin-nav-active">Materiais</span>
				} else {
					<a class="admin-nav-link" href="/admin/materiais">Materiais</a>
				}
				if active == "colors" {
					<span class="admin-nav-active">Cores</span>
				} else {
					<a class="admin-nav-link" href="/admin/cores">Cores</a>
				}
				if active == "boxes" {
					<span class="admin-nav-active">Caixas</span>
				} else {
					<a class="admin-nav-link" href="/admin/caixas">Caixas</a>
				}
			</nav>
			<form method="post" action="/admin/logout">
				<button class="btn-base btn-secondary" type="submit">Sair</button>
			</form>
		</aside>
		{ children... }
	</div>
}

templ AdminUnavailable() {
	@components.PrivateNoIndexLayout("Admin indisponivel | PrintLab", "Administracao temporariamente indisponivel.") {
		<section class="section-block">
			@components.Container() {
				@components.EmptyState("Administração temporariamente indisponível.", "Nao foi possivel carregar a administracao agora.")
			}
		</section>
	}
}
