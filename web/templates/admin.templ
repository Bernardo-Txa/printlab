package templates

import (
	"strconv"

	admindomain "github.com/Bernardo-Txa/printlab/internal/admin"
	"github.com/Bernardo-Txa/printlab/web/components"
)

templ AdminLogin(message string) {
	@components.PrivateNoIndexLayout("Admin | PrintLab", "Acesso administrativo da PrintLab.") {
		<section class="admin-auth-section">
			@components.Container() {
				<div class="admin-auth-panel">
					<div class="admin-auth-heading">
						<p class="brand-kicker">PrintLab Admin</p>
						<h1>Acesso administrativo</h1>
					</div>
					if message != "" {
						<p class="checkout-alert checkout-alert-error">{ message }</p>
					}
					<form class="admin-login-form" method="post" action="/admin/login">
						<label>
							<span>E-mail</span>
							<input type="email" name="email" autocomplete="email" required/>
						</label>
						<label>
							<span>Senha</span>
							<input type="password" name="password" autocomplete="current-password" required/>
						</label>
						<button class="btn-base btn-primary" type="submit">Entrar</button>
					</form>
				</div>
			}
		</section>
	}
}

templ AdminDashboard(dashboard admindomain.Dashboard) {
	@components.PrivateNoIndexLayout("Painel administrativo | PrintLab", "Painel administrativo da PrintLab.") {
		<section class="admin-section">
			@components.Container() {
				@adminShell("dashboard") {
					<div class="admin-main">
						<div class="admin-heading">
							<p class="brand-kicker">Operação</p>
							<h1>Visão geral</h1>
						</div>
						<div class="admin-metrics" aria-label="Resumo operacional">
							@adminMetric("Aguardando pagamento", dashboard.PendingPayment, "/admin/pedidos?status=pending_payment")
							@adminMetric("Pagos aguardando produção", dashboard.PaidWaitingProduction, "/admin/pedidos?status=waiting_production")
							@adminMetric("Em produção", dashboard.InProduction, "/admin/pedidos?status=in_production")
							@adminMetric("Aguardando envio", dashboard.WaitingShipment, "/admin/pedidos?status=waiting_shipment")
						</div>
					</div>
				}
			}
		</section>
	}
}

templ AdminOrders(page admindomain.OrderListPage) {
	@components.PrivateNoIndexLayout("Pedidos administrativos | PrintLab", "Pedidos administrativos da PrintLab.") {
		<section class="admin-section">
			@components.Container() {
				@adminShell("orders") {
					<div class="admin-main">
						<div class="admin-heading admin-heading-row">
							<div>
								<p class="brand-kicker">Pedidos</p>
								<h1>{ page.StatusLabel }</h1>
							</div>
						</div>
						<div class="admin-filters" aria-label="Filtros de pedidos">
							for _, option := range page.Options {
								if option.Active {
									<span class="admin-filter-link admin-filter-active">{ option.Label }</span>
								} else {
									<a class="admin-filter-link" href={ option.URL }>{ option.Label }</a>
								}
							}
						</div>
						if len(page.Orders) == 0 {
							<div class="admin-empty">
								<h2>Nenhum pedido neste filtro</h2>
								<p>Quando houver pedidos nesta etapa, eles aparecerao aqui.</p>
							</div>
						} else {
							<div class="admin-order-list">
								for _, order := range page.Orders {
									<article class="admin-order-row">
										<div class="admin-order-row-header">
											<div>
												<a href={ order.DetailURL }>{ order.OrderNumberLabel }</a>
												<span>{ order.CreatedAtLabel }</span>
											</div>
											<strong>{ order.TotalBRL }</strong>
										</div>
										<div class="admin-status-grid" aria-label="Status do pedido">
											<p><span>Pagamento</span><strong>{ order.OrderStatusLabel }</strong></p>
											<p><span>Producao</span><strong>{ order.ProductionStatusLabel }</strong></p>
											<p><span>Envio</span><strong>{ order.ShippingStatusLabel }</strong></p>
										</div>
										<div class="admin-order-meta">
											<span>{ strconv.Itoa(order.ItemCount) } itens</span>
											<span>{ strconv.Itoa(order.UnitCount) } unidades</span>
											<a href={ order.DetailURL }>Abrir pedido</a>
										</div>
									</article>
								}
							</div>
						}
						if page.HasPrevious || page.HasNext {
							<nav class="admin-pagination" aria-label="Paginacao de pedidos">
								if page.HasPrevious {
									<a class="btn-base btn-secondary" href={ admindomain.AdminOrdersURL(page.Status, page.PreviousPage) }>Anterior</a>
								}
								<span>Pagina { strconv.Itoa(page.Page) }</span>
								if page.HasNext {
									<a class="btn-base btn-secondary" href={ admindomain.AdminOrdersURL(page.Status, page.NextPage) }>Proxima</a>
								}
							</nav>
						}
					</div>
				}
			}
		</section>
	}
}

templ AdminOrderDetail(detail admindomain.OrderDetail, successMessage string, errorMessage string) {
	@components.PrivateNoIndexLayout("Pedido administrativo | PrintLab", "Detalhe administrativo do pedido PrintLab.") {
		<section class="admin-section">
			@components.Container() {
				@adminShell("orders") {
					<div class="admin-main">
						<div class="admin-heading admin-heading-row">
							<div>
								<p class="brand-kicker">Pedido</p>
								<h1>{ detail.OrderNumberLabel }</h1>
							</div>
							<div class="admin-heading-actions">
								<a class="btn-base btn-secondary" href="/admin/pedidos">Voltar</a>
								if detail.TrackingURL != "" {
									<a class="btn-base btn-secondary" href={ detail.TrackingURL }>Acompanhamento</a>
								}
							</div>
						</div>
						if successMessage != "" {
							<p class="checkout-alert checkout-alert-success">{ successMessage }</p>
						}
						if errorMessage != "" {
							<p class="checkout-alert checkout-alert-error">{ errorMessage }</p>
						}
						<div class="admin-status-grid admin-status-grid-wide" aria-label="Status do pedido">
							<p><span>Pagamento</span><strong>{ detail.OrderStatusLabel }</strong></p>
							<p><span>Producao</span><strong>{ detail.ProductionStatusLabel }</strong></p>
							<p><span>Envio</span><strong>{ detail.ShippingStatusLabel }</strong></p>
							<p><span>Total</span><strong>{ detail.TotalBRL }</strong></p>
						</div>
						<section class="admin-panel" aria-labelledby="admin-order-actions">
							<h2 id="admin-order-actions">Operacao</h2>
							<div class="admin-action-grid">
								<div>
									<h3>Producao</h3>
									if len(detail.ProductionActions) == 0 {
										<p>Nenhuma acao de producao disponivel.</p>
									} else {
										for _, action := range detail.ProductionActions {
											<form method="post" action={ "/admin/pedidos/" + detail.ID + "/producao" }>
												<input type="hidden" name="production_status" value={ action.Status }/>
												<button class="btn-base btn-primary" type="submit">{ action.Label }</button>
											</form>
										}
									}
								</div>
								<div>
									<h3>Envio</h3>
									if len(detail.ShippingActions) == 0 {
										<p>Nenhuma acao de envio disponivel.</p>
									} else {
										for _, action := range detail.ShippingActions {
											<form method="post" action={ "/admin/pedidos/" + detail.ID + "/envio" }>
												<input type="hidden" name="shipping_status" value={ action.Status }/>
												<button class="btn-base btn-primary" type="submit">{ action.Label }</button>
											</form>
										}
									}
								</div>
							</div>
						</section>
						<div class="admin-detail-grid">
							<section class="admin-panel" aria-labelledby="admin-order-customer">
								<h2 id="admin-order-customer">Cliente</h2>
								<div class="admin-field-grid">
									<p><span>Nome</span><strong>{ detail.Customer.FullName }</strong></p>
									<p><span>E-mail</span><strong>{ detail.Customer.Email }</strong></p>
									<p><span>Telefone</span><strong>{ detail.Customer.Phone }</strong></p>
									<p><span>CPF</span><strong>{ detail.Customer.CPF }</strong></p>
								</div>
							</section>
							<section class="admin-panel" aria-labelledby="admin-order-address">
								<h2 id="admin-order-address">Entrega</h2>
								<div class="admin-field-grid">
									<p><span>Endereco</span><strong>{ detail.Address.LineOne }</strong></p>
									<p><span>Cidade</span><strong>{ detail.Address.LineTwo }</strong></p>
									<p><span>Pais</span><strong>{ detail.Address.CountryCode }</strong></p>
								</div>
							</section>
						</div>
						<div class="admin-detail-grid">
							<section class="admin-panel" aria-labelledby="admin-order-shipping">
								<h2 id="admin-order-shipping">Frete</h2>
								<div class="admin-field-grid">
									<p><span>Servico</span><strong>{ detail.Shipping.ServiceName }</strong></p>
									if detail.Shipping.CarrierName != "" {
										<p><span>Transportadora</span><strong>{ detail.Shipping.CarrierName }</strong></p>
									}
									<p><span>Prazo</span><strong>{ detail.Shipping.DeliveryTime }</strong></p>
									<p><span>Caixa</span><strong>{ detail.Shipping.ShippingBoxName }</strong></p>
									<p><span>Peso</span><strong>{ detail.Shipping.PackageWeightLabel }</strong></p>
									<p><span>Dimensoes</span><strong>{ detail.Shipping.DimensionsLabel }</strong></p>
									<p><span>Preco</span><strong>{ detail.Shipping.PriceBRL }</strong></p>
									if detail.Shipping.QuotedAtLabel != "" {
										<p><span>Cotado em</span><strong>{ detail.Shipping.QuotedAtLabel }</strong></p>
									}
								</div>
							</section>
							<section class="admin-panel" aria-labelledby="admin-order-payment">
								<h2 id="admin-order-payment">Pagamento</h2>
								<div class="admin-field-grid">
									<p><span>Status</span><strong>{ detail.Payment.StatusLabel }</strong></p>
									if detail.Payment.AmountBRL != "" {
										<p><span>Valor validado</span><strong>{ detail.Payment.AmountBRL }</strong></p>
									}
									if detail.Payment.PaidAmountBRL != "" {
										<p><span>Valor pago</span><strong>{ detail.Payment.PaidAmountBRL }</strong></p>
									}
									if detail.Payment.InstallmentsLabel != "" {
										<p><span>Parcelas</span><strong>{ detail.Payment.InstallmentsLabel }</strong></p>
									}
									if detail.Payment.CaptureMethod != "" {
										<p><span>Captura</span><strong>{ detail.Payment.CaptureMethod }</strong></p>
									}
									if detail.Payment.PaidAtLabel != "" {
										<p><span>Pago em</span><strong>{ detail.Payment.PaidAtLabel }</strong></p>
									}
								</div>
							</section>
						</div>
						<section class="admin-panel" aria-labelledby="admin-order-items">
							<h2 id="admin-order-items">Itens</h2>
							<div class="admin-item-list">
								for _, item := range detail.Items {
									<article class="admin-item">
										<div class="admin-order-row-header">
											<div>
												<h3>{ item.ProductName }</h3>
												if item.HasVariant {
													<span>{ item.VariantName }</span>
												}
												if item.SKU != "" {
													<span>{ item.SKU }</span>
												}
											</div>
											<strong>{ item.LineTotalBRL }</strong>
										</div>
										<div class="admin-status-grid">
											<p><span>Quantidade</span><strong>{ strconv.Itoa(item.Quantity) }</strong></p>
											<p><span>Unitario</span><strong>{ item.UnitPriceBRL }</strong></p>
											if item.UnitPrintTimeMinutes != nil {
												<p><span>Tempo unitario</span><strong>{ strconv.Itoa(*item.UnitPrintTimeMinutes) } min</strong></p>
											}
											if item.UnitEstimatedFilamentWeightLabel != "" {
												<p><span>Filamento unitario</span><strong>{ item.UnitEstimatedFilamentWeightLabel }</strong></p>
											}
										</div>
										if len(item.Filaments) > 0 {
											<div class="admin-filaments">
												for _, filament := range item.Filaments {
													<p>
														if filament.HexColor != "" {
															<span class="admin-swatch" style={ "background-color: " + filament.HexColor }></span>
														}
														<strong>{ filament.MaterialName } / { filament.ColorName }</strong>
														<span>{ filament.EstimatedWeightLabel }</span>
														if filament.Label != "" {
															<span>{ filament.Label }</span>
														}
													</p>
												}
											</div>
										}
									</article>
								}
							</div>
						</section>
						<section class="admin-panel" aria-labelledby="admin-order-events">
							<h2 id="admin-order-events">Auditoria</h2>
							if len(detail.Events) == 0 {
								<p class="admin-muted">Nenhum evento operacional registrado.</p>
							} else {
								<div class="admin-event-list">
									for _, event := range detail.Events {
										<article class="admin-event">
											<strong>{ event.EventTypeLabel }</strong>
											<span>{ event.CreatedAtLabel }</span>
											<p>{ event.FromStatusLabel } -> { event.ToStatusLabel }</p>
										</article>
									}
								</div>
							}
						</section>
					</div>
				}
			}
		</section>
	}
}

templ AdminProducts(page admindomain.AdminProductListPage) {
	@components.PrivateNoIndexLayout("Produtos administrativos | PrintLab", "Produtos administrativos da PrintLab.") {
		<section class="admin-section">
			@components.Container() {
				@adminShell("products") {
					<div class="admin-main">
						<div class="admin-heading admin-heading-row">
							<div>
								<p class="brand-kicker">Catalogo</p>
								<h1>Produtos</h1>
							</div>
							<div class="admin-heading-actions">
								<a class="btn-base btn-primary" href="/admin/produtos/novo">Novo produto</a>
							</div>
						</div>
						<form class="admin-search-form" method="get" action="/admin/produtos">
							if page.Status != "all" {
								<input type="hidden" name="status" value={ page.Status }/>
							}
							<label for="admin-products-query">Buscar por nome ou slug</label>
							<div>
								<input id="admin-products-query" type="search" name="q" value={ page.Query }/>
								<button class="btn-base btn-secondary" type="submit">Buscar</button>
							</div>
						</form>
						<div class="admin-filters" aria-label="Filtros de produtos">
							for _, option := range page.Options {
								if option.Active {
									<span class="admin-filter-link admin-filter-active">{ option.Label }</span>
								} else {
									<a class="admin-filter-link" href={ option.URL }>{ option.Label }</a>
								}
							}
						</div>
						if len(page.Products) == 0 {
							<div class="admin-empty">
								<h2>Nenhum produto encontrado</h2>
								<p>Os produtos cadastrados aparecerao aqui.</p>
							</div>
						} else {
							<div class="admin-order-list">
								for _, product := range page.Products {
									<article class="admin-order-row">
										<div class="admin-order-row-header">
											<div>
												<a href={ product.DetailURL }>{ product.Name }</a>
												<span>{ product.Slug }</span>
											</div>
											<strong>{ product.PriceBRL }</strong>
										</div>
										<div class="admin-status-grid">
											<p><span>Categoria</span><strong>{ product.CategoryLabel }</strong></p>
											<p><span>Status</span><strong>{ product.StatusLabel }</strong></p>
											<p><span>Destaque</span><strong>{ product.FeaturedLabel }</strong></p>
											<p><span>Variantes</span><strong>{ product.VariantCountLabel }</strong></p>
											<p><span>Frete</span><strong>{ product.ShippingLabel }</strong></p>
											<p><span>Imagens</span><strong>Fase 13.4</strong></p>
										</div>
										if len(product.Warnings) > 0 {
											<div class="admin-warning-list">
												for _, warning := range product.Warnings {
													<p>{ warning }</p>
												}
											</div>
										}
										<div class="admin-order-meta">
											<a href={ product.DetailURL }>Editar produto</a>
										</div>
									</article>
								}
							</div>
						}
					</div>
				}
			}
		</section>
	}
}

templ AdminProductForm(page admindomain.AdminProductFormPage) {
	@components.PrivateNoIndexLayout(page.Title + " | PrintLab", "Produto administrativo da PrintLab.") {
		<section class="admin-section">
			@components.Container() {
				@adminShell("products") {
					<div class="admin-main">
						@adminFormHeader("Catalogo", page.Title, page.BackURL)
						if page.Message != "" {
							<p class="checkout-alert checkout-alert-success">{ page.Message }</p>
						}
						<form class="admin-form" method="post" action={ page.Action }>
							@adminTextField("name", "Nome", page.Form.Name, page.Errors.Get("name"), "text", true)
							@adminTextField("slug", "Slug", page.Form.Slug, page.Errors.Get("slug"), "text", false)
							@adminSelectField("category_id", "Categoria", page.Form.CategoryID, page.Categories, page.Errors.Get("category_id"), "Sem categoria")
							@adminTextField("price", "Preco", page.Form.PriceBRL, page.Errors.Get("price"), "text", true)
							@adminTextareaField("short_description", "Resumo", page.Form.ShortDescription, page.Errors.Get("short_description"))
							@adminTextareaField("description", "Descricao", page.Form.Description, page.Errors.Get("description"))
							<div class="admin-checkbox-grid">
								@adminCheckboxField("is_active", "Produto ativo", page.Form.IsActive)
								@adminCheckboxField("is_featured", "Destacado", page.Form.IsFeatured)
							</div>
							@adminShippingProfileFields(page.Form.UseShipping, page.Form.ShippingWeightG, page.Form.ShippingHeightMM, page.Form.ShippingWidthMM, page.Form.ShippingLengthMM, page.Errors)
							<div class="admin-form-actions">
								<button class="btn-base btn-primary" type="submit">{ page.SubmitLabel }</button>
								<a class="btn-base btn-secondary" href={ page.BackURL }>Cancelar</a>
							</div>
						</form>
						if !page.IsNew {
							<section class="admin-panel" aria-labelledby="admin-product-variants">
								<div class="admin-heading-row">
									<h2 id="admin-product-variants">Variantes</h2>
									<a class="btn-base btn-secondary" href={ page.Action + "/variantes/nova" }>Nova variante</a>
								</div>
								if len(page.Variants) == 0 {
									<p class="admin-muted">Nenhuma variante cadastrada.</p>
								} else {
									<div class="admin-item-list">
										for _, variant := range page.Variants {
											<article class="admin-item">
												<div class="admin-order-row-header">
													<div>
														<a href={ variant.DetailURL }>{ variant.Name }</a>
														<span>{ variant.Slug }</span>
														if variant.SKU != "" {
															<span>{ variant.SKU }</span>
														}
													</div>
													<strong>{ variant.PriceLabel }</strong>
												</div>
												<div class="admin-status-grid">
													<p><span>Status</span><strong>{ variant.StatusLabel }</strong></p>
													<p><span>Default</span><strong>{ variant.DefaultLabel }</strong></p>
													<p><span>Ordem</span><strong>{ strconv.Itoa(variant.SortOrder) }</strong></p>
													<p><span>Tempo</span><strong>{ variant.PrintTimeLabel }</strong></p>
													<p><span>Frete</span><strong>{ variant.ShippingLabel }</strong></p>
													<p><span>Receita</span><strong>{ strconv.Itoa(variant.RecipeCount) } componentes / { variant.RecipeWeightLabel }</strong></p>
												</div>
											</article>
										}
									</div>
								}
							</section>
						}
					</div>
				}
			}
		</section>
	}
}

templ AdminCategories(page admindomain.AdminCategoryListPage) {
	@adminSimpleEntityList("categories", "Categorias", "/admin/categorias/nova") {
		for _, item := range page.Categories {
			@adminEntityCard(item.Name, item.Slug, item.StatusLabel, item.DetailURL, item.Description)
		}
	}
}

templ AdminCategoryForm(page admindomain.AdminCategoryFormPage) {
	@adminBasicTextForm("categories", page.Title, page.Action, page.BackURL, page.SubmitLabel, page.Message, page.Form.Name, page.Form.Slug, page.Form.Description, page.Form.IsActive, page.Errors)
}

templ AdminVariantForm(page admindomain.AdminVariantFormPage) {
	@components.PrivateNoIndexLayout(page.Title + " | PrintLab", "Variante administrativa da PrintLab.") {
		<section class="admin-section">
			@components.Container() {
				@adminShell("products") {
					<div class="admin-main">
						@adminFormHeader(page.Product.Name, page.Title, page.BackURL)
						if page.Message != "" {
							<p class="checkout-alert checkout-alert-success">{ page.Message }</p>
						}
						<form class="admin-form" method="post" action={ page.Action }>
							@adminTextField("name", "Nome", page.Form.Name, page.Errors.Get("name"), "text", true)
							@adminTextField("slug", "Slug", page.Form.Slug, page.Errors.Get("slug"), "text", false)
							@adminTextField("sku", "SKU", page.Form.SKU, page.Errors.Get("sku"), "text", false)
							@adminTextField("price", "Preco proprio", page.Form.PriceBRL, page.Errors.Get("price"), "text", false)
							<div class="admin-checkbox-grid">
								@adminCheckboxField("is_active", "Variante ativa", page.Form.IsActive)
								@adminCheckboxField("is_default", "Variante default", page.Form.IsDefault)
							</div>
							@adminTextField("sort_order", "Ordem", page.Form.SortOrder, page.Errors.Get("sort_order"), "number", true)
							@adminTextField("print_time_minutes", "Tempo de impressao em minutos", page.Form.PrintTimeMinutes, page.Errors.Get("print_time_minutes"), "number", false)
							@adminShippingProfileFields(page.Form.UseShipping, page.Form.ShippingWeightG, page.Form.ShippingHeightMM, page.Form.ShippingWidthMM, page.Form.ShippingLengthMM, page.Errors)
							<div class="admin-form-actions">
								<button class="btn-base btn-primary" type="submit">{ page.SubmitLabel }</button>
								<a class="btn-base btn-secondary" href={ page.BackURL }>Cancelar</a>
							</div>
						</form>
						if !page.IsNew {
							<section class="admin-panel" aria-labelledby="admin-variant-recipe">
								<h2 id="admin-variant-recipe">Receita de produção</h2>
								if len(page.Recipe) == 0 {
									<p class="admin-muted">Nenhum componente cadastrado.</p>
								} else {
									<div class="admin-item-list">
										for _, component := range page.Recipe {
											<article class="admin-item">
												<form class="admin-inline-form" method="post" action={ component.UpdateAction }>
													@adminRecipeFields(component.MaterialID, component.ColorID, component.EstimatedWeightInput, component.Label, component.SortOrderInput, page.MaterialOptions, page.ColorOptions)
													<button class="btn-base btn-secondary" type="submit">Salvar componente</button>
												</form>
												<form method="post" action={ component.RemoveAction }>
													<button class="btn-base btn-secondary" type="submit">Remover componente</button>
												</form>
												<p class="admin-muted">{ component.MaterialLabel } / { component.ColorLabel } — { component.EstimatedWeightLabel }</p>
											</article>
										}
									</div>
								}
								<form class="admin-form admin-form-compact" method="post" action={ page.Action + "/receita" }>
									<h3>Novo componente</h3>
									@adminRecipeFields(page.RecipeForm.MaterialID, page.RecipeForm.ColorID, page.RecipeForm.EstimatedWeight, page.RecipeForm.Label, page.RecipeForm.SortOrder, page.MaterialOptions, page.ColorOptions)
									<button class="btn-base btn-primary" type="submit">Adicionar componente</button>
								</form>
							</section>
						}
					</div>
				}
			}
		</section>
	}
}

templ AdminMaterials(page admindomain.AdminMaterialListPage) {
	@adminSimpleEntityList("materials", "Materiais", "/admin/materiais/novo") {
		for _, item := range page.Materials {
			@adminEntityCard(item.Name, item.Slug, item.StatusLabel, item.DetailURL, item.Description)
		}
	}
}

templ AdminMaterialForm(page admindomain.AdminMaterialFormPage) {
	@adminBasicTextForm("materials", page.Title, page.Action, page.BackURL, page.SubmitLabel, page.Message, page.Form.Name, page.Form.Slug, page.Form.Description, page.Form.IsActive, page.Errors)
}

templ AdminColors(page admindomain.AdminColorListPage) {
	@components.PrivateNoIndexLayout("Cores administrativas | PrintLab", "Cores administrativas da PrintLab.") {
		<section class="admin-section">
			@components.Container() {
				@adminShell("colors") {
					<div class="admin-main">
						@adminListHeader("Cores", "/admin/cores/nova")
						<div class="admin-order-list">
							for _, item := range page.Colors {
								<article class="admin-order-row">
									<div class="admin-order-row-header">
										<div>
											<a href={ item.DetailURL }>{ item.Name }</a>
											<span>{ item.Slug }</span>
										</div>
										<strong>{ item.StatusLabel }</strong>
									</div>
									<div class="admin-order-meta">
										if item.HexColor != "" {
											<span class="admin-swatch" style={ "background-color: " + item.HexColor }></span>
											<span>{ item.HexColor }</span>
										} else {
											<span>Sem hexadecimal</span>
										}
									</div>
								</article>
							}
						</div>
					</div>
				}
			}
		</section>
	}
}

templ AdminColorForm(page admindomain.AdminColorFormPage) {
	@components.PrivateNoIndexLayout(page.Title + " | PrintLab", "Cor administrativa da PrintLab.") {
		<section class="admin-section">
			@components.Container() {
				@adminShell("colors") {
