package templates

import (
	"fmt"
	"github.com/Bernardo-Txa/printlab/internal/customerauth"
	"github.com/Bernardo-Txa/printlab/internal/customerprofile"
	"github.com/Bernardo-Txa/printlab/internal/customers"
	"github.com/Bernardo-Txa/printlab/internal/orders"
	"github.com/Bernardo-Txa/printlab/web/components"
)

type AccountPageView struct {
	Profile customerauth.Profile
	Orders  []orders.AccountOrder
	Saved   customerprofile.Profile
	Errors  customers.FieldErrors
	Success bool
	Message string
	MessageIsError bool
	PaymentAvailable bool
}

templ SignupPage(form customerauth.SignupForm) {
	@components.PrivateNoIndexLayout("Cadastro | PrintLab", "Crie sua conta de cliente na PrintLab.") {
		<section class="admin-auth-section">
			@components.Container() {
				<div class="admin-auth-panel">
					<div class="admin-auth-heading">
						<p class="brand-kicker">Conta PrintLab</p>
						<h1>Criar conta</h1>
						<p>Use sua conta para acessar a área inicial da PrintLab. A compra como convidado continua disponível.</p>
					</div>
					if form.Message != "" {
						<p class="checkout-alert checkout-alert-success">{ form.Message }</p>
					}
					if form.Errors.Any() {
						<p class="checkout-alert checkout-alert-error">Revise os campos destacados antes de continuar.</p>
					}
					<form class="admin-login-form" method="post" action="/cadastro">
						@AuthField("name", "Nome", "text", "name", form.Name, form.Errors.Message("name"), "")
						@AuthField("email", "E-mail", "email", "email", form.Email, form.Errors.Message("email"), "")
						@AuthField("password", "Senha", "password", "new-password", "", form.Errors.Message("password"), "")
						@AuthField("confirm_password", "Confirmar senha", "password", "new-password", "", form.Errors.Message("confirm_password"), "")
						<button class="btn-base btn-primary" type="submit">Criar conta</button>
					</form>
					<p class="auth-secondary-link">Já tem conta? <a href="/login">Entrar</a></p>
				</div>
			}
		</section>
	}
}

templ LoginPage(form customerauth.LoginForm) {
	@components.PrivateNoIndexLayout("Entrar | PrintLab", "Entre na sua conta de cliente PrintLab.") {
		<section class="admin-auth-section">
			@components.Container() {
				<div class="admin-auth-panel">
					<div class="admin-auth-heading">
						<p class="brand-kicker">Conta PrintLab</p>
						<h1>Entrar</h1>
					</div>
					if form.Message != "" {
						if form.Message == customerauth.MessagePasswordUpdated {
							<div class="auth-success-message" role="status">
								<strong>Senha atualizada com sucesso!</strong>
								<span>Agora você já pode entrar na sua conta com a nova senha.</span>
							</div>
						} else {
							<p class="checkout-alert checkout-alert-error">{ form.Message }</p>
						}
					}
					if form.Errors.Any() {
						<p class="checkout-alert checkout-alert-error">Revise os campos destacados antes de continuar.</p>
					}
					<form class="admin-login-form" method="post" action="/login">
						<input type="hidden" name="next" value={ form.Next }/>
						@AuthField("email", "E-mail", "email", "email", form.Email, form.Errors.Message("email"), "")
						@AuthField("password", "Senha", "password", "current-password", "", form.Errors.Message("password"), "")
						<button class="btn-base btn-primary" type="submit">Entrar</button>
					</form>
					<div class="auth-secondary-actions">
						<a href="/recuperar-senha">Esqueci minha senha</a>
						<a href="/cadastro">Criar conta</a>
					</div>
				</div>
			}
		</section>
	}
}

templ RecoveryPage(form customerauth.RecoveryForm) {
	@components.PrivateNoIndexLayout("Recuperar senha | PrintLab", "Recupere o acesso à sua conta PrintLab.") {
		<section class="admin-auth-section">
			@components.Container() {
				<div class="admin-auth-panel">
					<div class="admin-auth-heading">
						<p class="brand-kicker">Conta PrintLab</p>
						<h1>Recuperar senha</h1>
						<p>Informe seu e-mail para receber as instruções de recuperação.</p>
					</div>
					if form.Message != "" {
						<p class="checkout-alert checkout-alert-success">{ form.Message }</p>
					}
					if form.Errors.Any() {
						<p class="checkout-alert checkout-alert-error">Revise os campos destacados antes de continuar.</p>
					}
					<form class="admin-login-form" method="post" action="/recuperar-senha">
						@AuthField("email", "E-mail", "email", "email", form.Email, form.Errors.Message("email"), "")
						<button class="btn-base btn-primary" type="submit">Enviar instruções</button>
					</form>
					<p class="auth-secondary-link"><a href="/login">Voltar para o login</a></p>
				</div>
			}
		</section>
	}
}

templ NewPasswordPage(form customerauth.NewPasswordForm) {
	@components.PrivateNoIndexLayout("Nova senha | PrintLab", "Defina uma nova senha para sua conta PrintLab.") {
		<section class="admin-auth-section">
			@components.Container() {
				<div class="admin-auth-panel">
					<div class="admin-auth-heading">
						<p class="brand-kicker">Conta PrintLab</p>
						<h1>Definir nova senha</h1>
					</div>
					if form.Message != "" {
						<p class="checkout-alert checkout-alert-error">{ form.Message }</p>
					}
					if form.Errors.Any() {
						<p class="checkout-alert checkout-alert-error">Revise os campos destacados antes de continuar.</p>
					}
					<form class="admin-login-form" method="post" action="/recuperar-senha/nova">
						@AuthField("password", "Nova senha", "password", "new-password", "", form.Errors.Message("password"), "")
						@AuthField("confirm_password", "Confirmar nova senha", "password", "new-password", "", form.Errors.Message("confirm_password"), "")
						<button class="btn-base btn-primary" type="submit">Atualizar senha</button>
					</form>
				</div>
			}
		</section>
	}
}

templ AccountPage(view AccountPageView) {
	@components.PrivateNoIndexLayout("Minha conta | PrintLab", "Área inicial da sua conta PrintLab.") {
		<section class="section-block">
			@components.Container() {
				<div class="section-heading">
					<p class="brand-kicker">Conta PrintLab</p>
					<h1>Minha conta</h1>
					<p>Área segura para consultar seus dados e pedidos.</p>
				</div>
				<div class="admin-panel account-panel">
					<h2>Meus pedidos</h2>
					if view.Message != "" {
						if view.MessageIsError {
							<p class="checkout-alert checkout-alert-error">{ view.Message }</p>
						} else {
							<p class="checkout-alert checkout-alert-success">{ view.Message }</p>
						}
					}
					if len(view.Orders) == 0 {
						<p>Você ainda não tem pedidos associados a esta conta.</p>
					} else {
						for _, order := range view.Orders {
							<div class="checkout-summary-line">
								<div>
									<strong>Pedido #{ fmt.Sprint(order.OrderNumber) }</strong>
									<span>{ order.CreatedAt.Format("02/01/2006") }</span>
									<span>{ order.StatusLabel }</span>
									if order.Status == orders.StatusPaid {
										<span>Pagamento confirmado.</span>
									}
								</div>
								<div>
									<p>{ order.TotalBRL }</p>
									<a href={ templ.URL(order.TrackingURL) }>Acompanhar pedido</a>
									if view.PaymentAvailable && order.Status == orders.StatusPendingPayment && order.ID != "" {
										<form method="post" action={ "/conta/pedidos/" + order.ID + "/pagar" }>
											<button class="btn-base btn-primary" type="submit">Retomar pagamento</button>
										</form>
									}
								</div>
							</div>
						}
					}
				</div>
				<div class="admin-panel account-panel"><h2>Dados pessoais e endereço</h2>
					if view.Success {
						<p class="checkout-alert checkout-alert-success">Dados atualizados com sucesso.</p>
					}
					if view.Errors.Any() {
						<p class="checkout-alert checkout-alert-error">Revise os campos destacados antes de salvar.</p>
					}
					<form method="post" action="/conta" class="checkout-form" data-checkout-form="true" data-cep-lookup-endpoint="/api/cep">
						<input type="hidden" name="country_code" value="BR"/>
						<section class="checkout-form-section" aria-labelledby="account-contact">
							<h3 id="account-contact">Contato</h3>
							<div class="checkout-fields">
								@CheckoutField("full_name", "Nome completo", "text", "name", "", view.Saved.FullName, view.Errors.Message("full_name"), false)
								@AccountReadonlyEmailField(view.Profile.Email)
								@CheckoutMaskedField("phone", "Telefone/WhatsApp", "tel", "tel", "tel", view.Saved.Phone, view.Errors.Message("phone"), "", false, "phone", "15")
								@CheckoutMaskedField("cpf", "CPF", "text", "off", "numeric", view.Saved.CPF, view.Errors.Message("cpf"), "", false, "cpf", "14")
							</div>
						</section>
						<section class="checkout-form-section" aria-labelledby="account-shipping">
							<h3 id="account-shipping">Endereço</h3>
							<div class="checkout-fields">
								@CheckoutPostalCodeField(view.Saved.PostalCode, view.Errors.Message("postal_code"))
								@CheckoutField("street", "Rua/logradouro", "text", "street-address", "", view.Saved.Street, view.Errors.Message("street"), false)
								@CheckoutField("number", "Número", "text", "address-line2", "", view.Saved.Number, view.Errors.Message("number"), false)
								@CheckoutField("complement", "Complemento", "text", "address-line3", "", view.Saved.Complement, view.Errors.Message("complement"), true)
								@CheckoutField("district", "Bairro", "text", "address-level3", "", view.Saved.District, view.Errors.Message("district"), false)
								@CheckoutField("city", "Cidade", "text", "address-level2", "", view.Saved.City, view.Errors.Message("city"), false)
								@CheckoutField("state", "UF", "text", "address-level1", "", view.Saved.State, view.Errors.Message("state"), false)
							</div>
						</section>
						<button class="btn-base btn-primary" type="submit">Salvar dados</button>
					</form>
				</div>
				<div class="admin-panel account-panel">
					<h2>Conta ativa</h2>
					<div class="admin-field-grid">
						if view.Profile.Name != "" {
							<p><span>Nome</span><strong>{ view.Profile.Name }</strong></p>
						}
						<p><span>E-mail</span><strong>{ view.Profile.Email }</strong></p>
						<p><span>Status</span><strong>Ativa</strong></p>
					</div>
					<form method="post" action="/logout">
						<button class="btn-base btn-secondary" type="submit">Sair</button>
					</form>
				</div>
			}
		</section>
		<script src="/static/js/checkout.js" defer></script>
	}
}

templ AccountReadonlyEmailField(value string) {
	<div class="checkout-field">
		<label for="account_email">E-mail</label>
		<input id="account_email" type="email" value={ value } autocomplete="email" readonly/>
	</div>
}

templ AuthCallbackPage(message string) {
	@components.PrivateNoIndexLayout("Confirmando acesso | PrintLab", "Confirmação segura de acesso à conta PrintLab.") {
		<section class="admin-auth-section auth-callback-section">
			@components.Container() {
				<div class="auth-status-card">
					if message != "" {
						<div class="auth-status-icon auth-status-icon-error" aria-hidden="true">!</div>
						<p class="brand-kicker">Conta PrintLab</p>
						<h1>Não foi possível confirmar seu acesso.</h1>
						<p data-auth-callback-status="true" aria-live="polite">{ message }</p>
						<div class="auth-status-actions">
							<a class="btn-base btn-primary" href="/recuperar-senha">Solicitar novo link</a>
							<a class="btn-base btn-secondary" href="/">Voltar para o início</a>
						</div>
					} else {
						<div class="auth-status-icon auth-status-icon-loading" aria-hidden="true">•</div>
						<p class="brand-kicker">Conta PrintLab</p>
						<h1>Confirmando seu e-mail...</h1>
						<p data-auth-callback-status="true" aria-live="polite">Aguarde enquanto finalizamos a autenticação com segurança.</p>
					}
					<noscript>
						<p class="checkout-alert checkout-alert-error">Ative o JavaScript para concluir a confirmação de acesso.</p>
					</noscript>
				</div>
			}
		</section>
		<script src="/static/js/auth-callback.js" defer></script>
	}
}

templ AuthCallbackSuccessPage() {
	@components.PrivateNoIndexLayout("E-mail confirmado | PrintLab", "E-mail confirmado com sucesso na PrintLab.") {
		<section class="admin-auth-section auth-callback-section">
			@components.Container() {
				<div class="auth-status-card auth-status-card-success">
					<div class="auth-status-icon auth-status-icon-success" aria-hidden="true">✓</div>
					<p class="brand-kicker">Conta PrintLab</p>
					<h1>E-mail confirmado!</h1>
					<p>Seu endereço de e-mail foi confirmado com sucesso. Sua conta PrintLab está pronta para uso.</p>
					<div class="auth-status-actions">
						<a class="btn-base btn-primary" href="/conta">Ir para minha conta</a>
						<a class="btn-base btn-secondary" href="/">Voltar para o início</a>
					</div>
				</div>
			}
		</section>
	}
}

templ AuthUnavailable() {
	@components.PrivateNoIndexLayout("Conta indisponível | PrintLab", "Conta PrintLab temporariamente indisponível.") {
		<section class="section-block">
			@components.Container() {
				@components.EmptyState("Conta temporariamente indisponível.", "Não foi possível acessar a autenticação agora. Tente novamente em alguns instantes.")
			}
		</section>
	}
}

templ AuthField(id string, label string, inputType string, autocomplete string, value string, message string, help string) {
	<label>
		<span>{ label }</span>
		<input id={ id } type={ inputType } name={ id } value={ value } autocomplete={ autocomplete } required/>
		if help != "" {
			<small>{ help }</small>
		}
		if message != "" {
			<small class="checkout-field-error">{ message }</small>
		}
	</label>
}
