package templates

import "strconv"

type checkoutStepView struct {
	Number  int
	Label   string
	Href    string
	State   string
	Current bool
}

templ CheckoutStepper(current int, paymentReviewLink bool) {
	<nav class="checkout-stepper" aria-label="Etapas do checkout">
		for _, step := range checkoutSteps(current, paymentReviewLink) {
			if step.Href != "" {
				if step.Current {
					<a class={ "checkout-step checkout-step-" + step.State } href={ step.Href } aria-current="step">
						@checkoutStepInner(step)
					</a>
				} else {
					<a class={ "checkout-step checkout-step-" + step.State } href={ step.Href }>
						@checkoutStepInner(step)
					</a>
				}
			} else {
				if step.Current {
					<span class={ "checkout-step checkout-step-" + step.State } aria-current="step">
						@checkoutStepInner(step)
					</span>
				} else {
					<span class={ "checkout-step checkout-step-" + step.State }>
						@checkoutStepInner(step)
					</span>
				}
			}
		}
	</nav>
}

templ checkoutStepInner(step checkoutStepView) {
	<span class="checkout-step-marker" aria-hidden="true">
		if step.State == "done" {
			<svg viewBox="0 0 24 24" focusable="false"><path d="m6 12.5 4 4L18 8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
		} else {
			{ strconv.Itoa(step.Number) }
		}
	</span>
	<span class="checkout-step-copy">
		<span class="checkout-step-label">{ step.Label }</span>
		if step.State == "done" {
			<span class="checkout-step-state">Concluída</span>
		} else if step.State == "active" {
			<span class="checkout-step-state">Etapa atual</span>
		} else {
			<span class="checkout-step-state">Próxima etapa</span>
		}
	</span>
}

func checkoutSteps(current int, paymentReviewLink bool) []checkoutStepView {
	steps := []checkoutStepView{
		{Number: 1, Label: "Dados", Href: "/checkout/dados"},
		{Number: 2, Label: "Entrega", Href: "/checkout/frete"},
		{Number: 3, Label: "Revisão", Href: "/checkout/revisao"},
		{Number: 4, Label: "Pagamento"},
	}
	for i := range steps {
		stepNumber := steps[i].Number
		switch {
		case stepNumber < current:
			steps[i].State = "done"
		case stepNumber == current:
			steps[i].State = "active"
			steps[i].Current = true
		default:
			steps[i].State = "future"
			steps[i].Href = ""
		}
	}
	if current <= 1 {
		steps[0].Href = ""
	}
	if current >= 4 && !paymentReviewLink {
		steps[2].Href = ""
	}
	return steps
}

