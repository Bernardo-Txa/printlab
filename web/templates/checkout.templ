package templates

import (
	"strconv"

	"github.com/Bernardo-Txa/printlab/internal/customers"
	"github.com/Bernardo-Txa/printlab/web/components"
)

templ CheckoutDetails(page customers.CheckoutPage) {
	@components.Layout("Dados | PrintLab", "Dados de contato e entrega para compra na PrintLab.", "") {
		<section class="checkout-section">
			@components.Container() {
				<div class="checkout-heading">
					<p class="brand-kicker">Checkout seguro</p>
					<p class="checkout-step-eyebrow">Etapa 1 de 4</p>
					<h1>Seus dados</h1>
					<p>Preencha seus dados de contato. O endereço será informado na próxima etapa, conforme a modalidade de entrega.</p>
				</div>
				@CheckoutStepper(1, false)
				if page.Form.Saved {
					<p class="checkout-alert checkout-alert-success">Dados salvos. Escolha a entrega na próxima etapa.</p>
				}
				if page.Form.HasErrors() {
					<p class="checkout-alert checkout-alert-error">Revise os campos destacados antes de continuar.</p>
				}
				<div class="checkout-layout">
					<form class="checkout-form" method="post" action="/checkout/dados" data-checkout-form="true">
						<input type="hidden" name="country_code" value="BR"/>
						<section class="checkout-form-section" aria-labelledby="checkout-contact">
							<div class="checkout-section-header">
								<span class="checkout-section-icon" aria-hidden="true">@checkoutProfileIcon()</span>
								<div>
									<h2 id="checkout-contact">Dados pessoais</h2>
									<p>Contato e identificação para acompanhar sua compra.</p>
								</div>
							</div>
							<div class="checkout-fields checkout-fields-personal">
								@CheckoutField("full_name", "Nome completo", "text", "name", "", page.Form.Values.FullName, page.Form.Errors.Message("full_name"), false)
								@CheckoutField("email", "E-mail", "email", "email", "", page.Form.Values.Email, page.Form.Errors.Message("email"), false)
								@CheckoutMaskedField("phone", "Telefone/WhatsApp", "tel", "tel", "tel", page.Form.Values.Phone, page.Form.Errors.Message("phone"), "", false, "phone", "15")
								@CheckoutMaskedField("cpf", "CPF", "text", "off", "numeric", page.Form.Values.CPF, page.Form.Errors.Message("cpf"), "Usado para identificação do pedido.", false, "cpf", "14")
							</div>
						</section>
						<div class="checkout-form-actions">
							<button class="btn-base btn-primary" type="submit">Continuar para entrega</button>
							<a class="btn-base btn-secondary" href="/carrinho">Voltar ao carrinho</a>
						</div>
					</form>
					<aside class="checkout-summary" aria-label="Resumo do carrinho">
						<h2>Resumo do carrinho</h2>
						<div class="checkout-summary-lines">
							for _, line := range page.Cart.Lines {
								if line.Available {
									<div class="checkout-summary-line">
										<div>
											<strong>{ line.ProductName }</strong>
											if line.ColorName != "" {
												<span>Cor: { line.ColorName }</span>
											}
											if line.HasVariant {
												<span>{ line.VariantName }</span>
											}
											<span>Quantidade: { strconv.Itoa(line.Quantity) }</span>
										</div>
										<p>{ line.SubtotalBRL }</p>
									</div>
								}
							}
						</div>
						<div class="checkout-summary-total checkout-summary-grand-total">
							<span>Total atual dos produtos</span>
							<strong>{ page.Cart.SubtotalBRL }</strong>
						</div>
						<p>Frete será calculado na próxima etapa.</p>
					</aside>
				</div>
			}
		</section>
		<script src="/static/js/checkout.js" defer></script>
	}
}

templ CheckoutField(id string, label string, inputType string, autocomplete string, inputMode string, value string, message string, optional bool) {
	@CheckoutFieldWithHelp(id, label, inputType, autocomplete, inputMode, value, message, "", optional)
}

templ CheckoutFieldWithHelp(id string, label string, inputType string, autocomplete string, inputMode string, value string, message string, help string, optional bool) {
	<div class="checkout-field">
		<label for={ id }>
			{ label }
			if optional {
				<span>Opcional</span>
			}
		</label>
		<input id={ id } type={ inputType } name={ id } value={ value } autocomplete={ autocomplete } inputmode={ inputMode } required?={ !optional }/>
		if help != "" {
			<p class="checkout-field-help">{ help }</p>
		}
		if message != "" {
			<p class="checkout-field-error">{ message }</p>
		}
	</div>
}

templ CheckoutMaskedField(id string, label string, inputType string, autocomplete string, inputMode string, value string, message string, help string, optional bool, mask string, maxLength string) {
	<div class="checkout-field">
		<label for={ id }>
			{ label }
			if optional {
				<span>Opcional</span>
			}
		</label>
		<input id={ id } type={ inputType } name={ id } value={ value } autocomplete={ autocomplete } inputmode={ inputMode } maxlength={ maxLength } data-checkout-mask={ mask } required?={ !optional }/>
		if help != "" {
			<p class="checkout-field-help">{ help }</p>
		}
		if message != "" {
			<p class="checkout-field-error">{ message }</p>
		}
	</div>
}

templ CheckoutPostalCodeField(value string, message string) {
	<div class="checkout-field">
		<label for="postal_code">CEP</label>
		<input id="postal_code" type="text" name="postal_code" value={ value } autocomplete="postal-code" inputmode="numeric" maxlength="9" data-checkout-mask="cep" data-cep-input="true" aria-describedby="postal_code_lookup_status" required/>
		<p id="postal_code_lookup_status" class="checkout-field-help" data-cep-status="true" aria-live="polite"></p>
		if message != "" {
			<p class="checkout-field-error">{ message }</p>
		}
	</div>
}

templ CheckoutDetailsUnavailable() {
	@components.Layout("Dados indisponíveis | PrintLab", "Dados de checkout temporariamente indisponíveis.", "") {
		<section class="section-block">
			@components.Container() {
				@components.EmptyState("Dados temporariamente indisponíveis.", "Não foi possível carregar esta etapa agora. Tente novamente em alguns instantes.")
			}
		</section>
	}
}
